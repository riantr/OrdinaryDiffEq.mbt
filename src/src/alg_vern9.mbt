// ---------------------------------------------------------------------------
// Interpolant weight polynomials
// ---------------------------------------------------------------------------

///|
/// `@evalpoly(x, c0, .., c8)` — a degree-8 Horner form.
///
/// Only the k1 term is a `theta * poly8`; every other weight is
/// `theta^2 * poly7` (interpolants.jl:674 `vern9pre0`).
fn vern9_poly8(
  x : Double,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  c3 : Double,
  c4 : Double,
  c5 : Double,
  c6 : Double,
  c7 : Double,
  c8 : Double,
) -> Double {
  c0 +
  x *
  (
    c1 +
    x * (c2 + x * (c3 + x * (c4 + x * (c5 + x * (c6 + x * (c7 + x * c8))))))
  )
}

///|
/// `@evalpoly(x, c0, .., c7)` — a degree-7 Horner form.
fn vern9_poly7(
  x : Double,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  c3 : Double,
  c4 : Double,
  c5 : Double,
  c6 : Double,
  c7 : Double,
) -> Double {
  c0 + x * (c1 + x * (c2 + x * (c3 + x * (c4 + x * (c5 + x * (c6 + x * c7))))))
}

///|
/// `b1'(x) = r011 + 2*r012*x + 3*r013*x^2 + .. + 9*r019*x^8`, written exactly as
/// Julia's `vern9pre1` does — the coefficients are multiplied by their exponents
/// rather than recombined into `poly8(x) + x*poly8'(x)`.
///
/// The leading `theta` factor is already inside `poly8`, so there is no extra
/// term here; that is why this one is not a `*_x2_d` shape.
fn vern9_poly8_x_d(
  x : Double,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  c3 : Double,
  c4 : Double,
  c5 : Double,
  c6 : Double,
  c7 : Double,
  c8 : Double,
) -> Double {
  c0 +
  x *
  (
    2.0 * c1 +
    x *
    (
      3.0 * c2 +
      x *
      (
        4.0 * c3 +
        x *
        (
          5.0 * c4 +
          x * (6.0 * c5 + x * (7.0 * c6 + x * (8.0 * c7 + x * 9.0 * c8)))
        )
      )
    )
  )
}

///|
/// `d/dx [x^2 * poly7(x)]` = `x * (2*c0 + x*(3*c1 + .. + x*9*c7))`, matching
/// `b_iΘdiff = Θ * @evalpoly(Θ, 2r_i2, 3r_i3, ..., 9r_i9)`.
fn vern9_poly7_x2_d(
  x : Double,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  c3 : Double,
  c4 : Double,
  c5 : Double,
  c6 : Double,
  c7 : Double,
) -> Double {
  x *
  (
    2.0 * c0 +
    x *
    (
      3.0 * c1 +
      x *
      (
        4.0 * c2 +
        x *
        (
          5.0 * c3 +
          x * (6.0 * c4 + x * (7.0 * c5 + x * (8.0 * c6 + x * 9.0 * c7)))
        )
      )
    )
  )
}

// ---------------------------------------------------------------------------
// Dense interpolant (interpolants.jl `vern9pre0` / `vern9pre1`)
// ---------------------------------------------------------------------------

///|
/// Dense output at fraction `theta` of a step:
///
///     y(theta) = y0 + dt * sum_{i} k[slot_i] * b_i(theta)
///
/// with `b1 = theta * poly8(r011..r019)` and every other
/// `b_i = theta^2 * poly7(r{i}2..r{i}9)` (interpolants.jl:674).
///
/// `ks` is the stored 20-slot stage group of the step. The weights cover
/// slots 1..9 and 11..20; slot 10 (k16) is skipped because it exists only for
/// the embedded error estimate.
fn vern9_interpolate(
  theta : Double,
  dt : Double,
  y0 : Array[Double],
  y1 : Array[Double],
  ks : Array[Array[Double]],
  out : Array[Double],
) -> Unit {
  let th2 = theta * theta
  // k1 is special: its weight is theta * poly8, not theta^2 * poly7.
  let b1 = theta *
    vern9_poly8(
      theta,
      Vern9R011,
      Vern9R012,
      Vern9R013,
      Vern9R014,
      Vern9R015,
      Vern9R016,
      Vern9R017,
      Vern9R018,
      Vern9R019,
    )
  let b2 = th2 *
    vern9_poly7(
      theta,
      Vern9R082,
      Vern9R083,
      Vern9R084,
      Vern9R085,
      Vern9R086,
      Vern9R087,
      Vern9R088,
      Vern9R089,
    )
  let b3 = th2 *
    vern9_poly7(
      theta,
      Vern9R092,
      Vern9R093,
      Vern9R094,
      Vern9R095,
      Vern9R096,
      Vern9R097,
      Vern9R098,
      Vern9R099,
    )
  let b4 = th2 *
    vern9_poly7(
      theta,
      Vern9R102,
      Vern9R103,
      Vern9R104,
      Vern9R105,
      Vern9R106,
      Vern9R107,
      Vern9R108,
      Vern9R109,
    )
  let b5 = th2 *
    vern9_poly7(
      theta,
      Vern9R112,
      Vern9R113,
      Vern9R114,
      Vern9R115,
      Vern9R116,
      Vern9R117,
      Vern9R118,
      Vern9R119,
    )
  let b6 = th2 *
    vern9_poly7(
      theta,
      Vern9R122,
      Vern9R123,
      Vern9R124,
      Vern9R125,
      Vern9R126,
      Vern9R127,
      Vern9R128,
      Vern9R129,
    )
  let b7 = th2 *
    vern9_poly7(
      theta,
      Vern9R132,
      Vern9R133,
      Vern9R134,
      Vern9R135,
      Vern9R136,
      Vern9R137,
      Vern9R138,
      Vern9R139,
    )
  let b8 = th2 *
    vern9_poly7(
      theta,
      Vern9R142,
      Vern9R143,
      Vern9R144,
      Vern9R145,
      Vern9R146,
      Vern9R147,
      Vern9R148,
      Vern9R149,
    )
  let b9 = th2 *
    vern9_poly7(
      theta,
      Vern9R152,
      Vern9R153,
      Vern9R154,
      Vern9R155,
      Vern9R156,
      Vern9R157,
      Vern9R158,
      Vern9R159,
    )
  let b11 = th2 *
    vern9_poly7(
      theta,
      Vern9R172,
      Vern9R173,
      Vern9R174,
      Vern9R175,
      Vern9R176,
      Vern9R177,
      Vern9R178,
      Vern9R179,
    )
  let b12 = th2 *
    vern9_poly7(
      theta,
      Vern9R182,
      Vern9R183,
      Vern9R184,
      Vern9R185,
      Vern9R186,
      Vern9R187,
      Vern9R188,
      Vern9R189,
    )
  let b13 = th2 *
    vern9_poly7(
      theta,
      Vern9R192,
      Vern9R193,
      Vern9R194,
      Vern9R195,
      Vern9R196,
      Vern9R197,
      Vern9R198,
      Vern9R199,
    )
  let b14 = th2 *
    vern9_poly7(
      theta,
      Vern9R202,
      Vern9R203,
      Vern9R204,
      Vern9R205,
      Vern9R206,
      Vern9R207,
      Vern9R208,
      Vern9R209,
    )
  let b15 = th2 *
    vern9_poly7(
      theta,
      Vern9R212,
      Vern9R213,
      Vern9R214,
      Vern9R215,
      Vern9R216,
      Vern9R217,
      Vern9R218,
      Vern9R219,
    )
  let b16 = th2 *
    vern9_poly7(
      theta,
      Vern9R222,
      Vern9R223,
      Vern9R224,
      Vern9R225,
      Vern9R226,
      Vern9R227,
      Vern9R228,
      Vern9R229,
    )
  let b17 = th2 *
    vern9_poly7(
      theta,
      Vern9R232,
      Vern9R233,
      Vern9R234,
      Vern9R235,
      Vern9R236,
      Vern9R237,
      Vern9R238,
      Vern9R239,
    )
  let b18 = th2 *
    vern9_poly7(
      theta,
      Vern9R242,
      Vern9R243,
      Vern9R244,
      Vern9R245,
      Vern9R246,
      Vern9R247,
      Vern9R248,
      Vern9R249,
    )
  let b19 = th2 *
    vern9_poly7(
      theta,
      Vern9R252,
      Vern9R253,
      Vern9R254,
      Vern9R255,
      Vern9R256,
      Vern9R257,
      Vern9R258,
      Vern9R259,
    )
  let b20 = th2 *
    vern9_poly7(
      theta,
      Vern9R262,
      Vern9R263,
      Vern9R264,
      Vern9R265,
      Vern9R266,
      Vern9R267,
      Vern9R268,
      Vern9R269,
    )
  let n = out.length()
  let mut i = 0
  while i < n {
    out.unsafe_set(
      i,
      y0.unsafe_get(i) +
      dt *
      (
        ks.unsafe_get(0).unsafe_get(i) * b1 +
        ks.unsafe_get(1).unsafe_get(i) * b2 +
        ks.unsafe_get(2).unsafe_get(i) * b3 +
        ks.unsafe_get(3).unsafe_get(i) * b4 +
        ks.unsafe_get(4).unsafe_get(i) * b5 +
        ks.unsafe_get(5).unsafe_get(i) * b6 +
        ks.unsafe_get(6).unsafe_get(i) * b7 +
        ks.unsafe_get(7).unsafe_get(i) * b8 +
        ks.unsafe_get(8).unsafe_get(i) * b9 +
        ks.unsafe_get(10).unsafe_get(i) * b11 +
        ks.unsafe_get(11).unsafe_get(i) * b12 +
        ks.unsafe_get(12).unsafe_get(i) * b13 +
        ks.unsafe_get(13).unsafe_get(i) * b14 +
        ks.unsafe_get(14).unsafe_get(i) * b15 +
        ks.unsafe_get(15).unsafe_get(i) * b16 +
        ks.unsafe_get(16).unsafe_get(i) * b17 +
        ks.unsafe_get(17).unsafe_get(i) * b18 +
        ks.unsafe_get(18).unsafe_get(i) * b19 +
        ks.unsafe_get(19).unsafe_get(i) * b20
      ),
    )
    i += 1
  }
}

///|
/// Time derivative of the dense output (`vern9pre1`, interpolants.jl:849):
///
///     dy/dt = sum_{i} k[slot_i] * b_i'(theta)
///
/// The `dt` in the value formula cancels against `dtheta/dt = 1/dt`, so — as in
/// Tsit5 and Vern7 — no `1/dt` factor survives here. `dt` and `y0` are accepted
/// for signature symmetry and ignored.
fn vern9_interpolate_derivative(
  theta : Double,
  _dt : Double,
  _y0 : Array[Double],
  _y1 : Array[Double],
  ks : Array[Array[Double]],
  out : Array[Double],
) -> Unit {
  let b1 = vern9_poly8_x_d(
    theta,
    Vern9R011,
    Vern9R012,
    Vern9R013,
    Vern9R014,
    Vern9R015,
    Vern9R016,
    Vern9R017,
    Vern9R018,
    Vern9R019,
  )
  let b2 = vern9_poly7_x2_d(
    theta,
    Vern9R082,
    Vern9R083,
    Vern9R084,
    Vern9R085,
    Vern9R086,
    Vern9R087,
    Vern9R088,
    Vern9R089,
  )
  let b3 = vern9_poly7_x2_d(
    theta,
    Vern9R092,
    Vern9R093,
    Vern9R094,
    Vern9R095,
    Vern9R096,
    Vern9R097,
    Vern9R098,
    Vern9R099,
  )
  let b4 = vern9_poly7_x2_d(
    theta,
    Vern9R102,
    Vern9R103,
    Vern9R104,
    Vern9R105,
    Vern9R106,
    Vern9R107,
    Vern9R108,
    Vern9R109,
  )
  let b5 = vern9_poly7_x2_d(
    theta,
    Vern9R112,
    Vern9R113,
    Vern9R114,
    Vern9R115,
    Vern9R116,
    Vern9R117,
    Vern9R118,
    Vern9R119,
  )
  let b6 = vern9_poly7_x2_d(
    theta,
    Vern9R122,
    Vern9R123,
    Vern9R124,
    Vern9R125,
    Vern9R126,
    Vern9R127,
    Vern9R128,
    Vern9R129,
  )
  let b7 = vern9_poly7_x2_d(
    theta,
    Vern9R132,
    Vern9R133,
    Vern9R134,
    Vern9R135,
    Vern9R136,
    Vern9R137,
    Vern9R138,
    Vern9R139,
  )
  let b8 = vern9_poly7_x2_d(
    theta,
    Vern9R142,
    Vern9R143,
    Vern9R144,
    Vern9R145,
    Vern9R146,
    Vern9R147,
    Vern9R148,
    Vern9R149,
  )
  let b9 = vern9_poly7_x2_d(
    theta,
    Vern9R152,
    Vern9R153,
    Vern9R154,
    Vern9R155,
    Vern9R156,
    Vern9R157,
    Vern9R158,
    Vern9R159,
  )
  let b11 = vern9_poly7_x2_d(
    theta,
    Vern9R172,
    Vern9R173,
    Vern9R174,
    Vern9R175,
    Vern9R176,
    Vern9R177,
    Vern9R178,
    Vern9R179,
  )
  let b12 = vern9_poly7_x2_d(
    theta,
    Vern9R182,
    Vern9R183,
    Vern9R184,
    Vern9R185,
    Vern9R186,
    Vern9R187,
    Vern9R188,
    Vern9R189,
  )
  let b13 = vern9_poly7_x2_d(
    theta,
    Vern9R192,
    Vern9R193,
    Vern9R194,
    Vern9R195,
    Vern9R196,
    Vern9R197,
    Vern9R198,
    Vern9R199,
  )
  let b14 = vern9_poly7_x2_d(
    theta,
    Vern9R202,
    Vern9R203,
    Vern9R204,
    Vern9R205,
    Vern9R206,
    Vern9R207,
    Vern9R208,
    Vern9R209,
  )
  let b15 = vern9_poly7_x2_d(
    theta,
    Vern9R212,
    Vern9R213,
    Vern9R214,
    Vern9R215,
    Vern9R216,
    Vern9R217,
    Vern9R218,
    Vern9R219,
  )
  let b16 = vern9_poly7_x2_d(
    theta,
    Vern9R222,
    Vern9R223,
    Vern9R224,
    Vern9R225,
    Vern9R226,
    Vern9R227,
    Vern9R228,
    Vern9R229,
  )
  let b17 = vern9_poly7_x2_d(
    theta,
    Vern9R232,
    Vern9R233,
    Vern9R234,
    Vern9R235,
    Vern9R236,
    Vern9R237,
    Vern9R238,
    Vern9R239,
  )
  let b18 = vern9_poly7_x2_d(
    theta,
    Vern9R242,
    Vern9R243,
    Vern9R244,
    Vern9R245,
    Vern9R246,
    Vern9R247,
    Vern9R248,
    Vern9R249,
  )
  let b19 = vern9_poly7_x2_d(
    theta,
    Vern9R252,
    Vern9R253,
    Vern9R254,
    Vern9R255,
    Vern9R256,
    Vern9R257,
    Vern9R258,
    Vern9R259,
  )
  let b20 = vern9_poly7_x2_d(
    theta,
    Vern9R262,
    Vern9R263,
    Vern9R264,
    Vern9R265,
    Vern9R266,
    Vern9R267,
    Vern9R268,
    Vern9R269,
  )
  let n = out.length()
  let mut i = 0
  while i < n {
    out.unsafe_set(
      i,
      ks.unsafe_get(0).unsafe_get(i) * b1 +
      ks.unsafe_get(1).unsafe_get(i) * b2 +
      ks.unsafe_get(2).unsafe_get(i) * b3 +
      ks.unsafe_get(3).unsafe_get(i) * b4 +
      ks.unsafe_get(4).unsafe_get(i) * b5 +
      ks.unsafe_get(5).unsafe_get(i) * b6 +
      ks.unsafe_get(6).unsafe_get(i) * b7 +
      ks.unsafe_get(7).unsafe_get(i) * b8 +
      ks.unsafe_get(8).unsafe_get(i) * b9 +
      ks.unsafe_get(10).unsafe_get(i) * b11 +
      ks.unsafe_get(11).unsafe_get(i) * b12 +
      ks.unsafe_get(12).unsafe_get(i) * b13 +
      ks.unsafe_get(13).unsafe_get(i) * b14 +
      ks.unsafe_get(14).unsafe_get(i) * b15 +
      ks.unsafe_get(15).unsafe_get(i) * b16 +
      ks.unsafe_get(16).unsafe_get(i) * b17 +
      ks.unsafe_get(17).unsafe_get(i) * b18 +
      ks.unsafe_get(18).unsafe_get(i) * b19 +
      ks.unsafe_get(19).unsafe_get(i) * b20,
    )
    i += 1
  }
}

// ---------------------------------------------------------------------------
// Coefficient invariants
//
// These mirror what tools/extract_verner.py validates on the Julia side, so a
// bad regeneration of alg_vern9_coeffs.mbt fails the test suite rather than
// silently producing a wrong method. They live here, not in vern9_test.mbt,
// because that file sees the package only through its public interface.
// ---------------------------------------------------------------------------

///|
test "vern9 tableau rows sum to their abscissae" {
  let tol = 0.000000001
  assert_true((Vern9A0201 - Vern9C1).abs() < tol)
  assert_true((Vern9A0301 + Vern9A0302 - Vern9C2).abs() < tol)
  assert_true((Vern9A0401 + Vern9A0403 - Vern9C3).abs() < tol)
  assert_true((Vern9A0501 + Vern9A0503 + Vern9A0504 - Vern9C4).abs() < tol)
  assert_true((Vern9A0601 + Vern9A0604 + Vern9A0605 - Vern9C5).abs() < tol)
  assert_true(
    (Vern9A0701 + Vern9A0704 + Vern9A0705 + Vern9A0706 - Vern9C6).abs() < tol,
  )
  assert_true((Vern9A0801 + Vern9A0806 + Vern9A0807 - Vern9C7).abs() < tol)
  assert_true(
    (Vern9A0901 + Vern9A0906 + Vern9A0907 + Vern9A0908 - Vern9C8).abs() < tol,
  )
  assert_true(
    (Vern9A1001 + Vern9A1006 + Vern9A1007 + Vern9A1008 + Vern9A1009 - Vern9C9).abs() <
    tol,
  )
  assert_true(
    (Vern9A1101 +
    Vern9A1106 +
    Vern9A1107 +
    Vern9A1108 +
    Vern9A1109 +
    Vern9A1110 -
    Vern9C10).abs() <
    tol,
  )
  assert_true(
    (Vern9A1201 +
    Vern9A1206 +
    Vern9A1207 +
    Vern9A1208 +
    Vern9A1209 +
    Vern9A1210 +
    Vern9A1211 -
    Vern9C11).abs() <
    tol,
  )
  assert_true(
    (Vern9A1301 +
    Vern9A1306 +
    Vern9A1307 +
    Vern9A1308 +
    Vern9A1309 +
    Vern9A1310 +
    Vern9A1311 +
    Vern9A1312 -
    Vern9C12).abs() <
    tol,
  )
  assert_true(
    (Vern9A1401 +
    Vern9A1406 +
    Vern9A1407 +
    Vern9A1408 +
    Vern9A1409 +
    Vern9A1410 +
    Vern9A1411 +
    Vern9A1412 +
    Vern9A1413 -
    Vern9C13).abs() <
    tol,
  )
  assert_true(
    (Vern9A1501 +
    Vern9A1506 +
    Vern9A1507 +
    Vern9A1508 +
    Vern9A1509 +
    Vern9A1510 +
    Vern9A1511 +
    Vern9A1512 +
    Vern9A1513 +
    Vern9A1514 -
    1.0).abs() <
    tol,
  )
  assert_true(
    (Vern9A1601 +
    Vern9A1606 +
    Vern9A1607 +
    Vern9A1608 +
    Vern9A1609 +
    Vern9A1610 +
    Vern9A1611 +
    Vern9A1612 +
    Vern9A1613 -
    1.0).abs() <
    tol,
  )
}

