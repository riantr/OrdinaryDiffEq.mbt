// Tsit5: the Tsitouras 5(4) embedded Runge-Kutta pair — 7 explicit stages,
// FSAL (the 7th stage is `f` at the new point and doubles as the next step's
// first stage), with the 4th-order "free" dense interpolant.
//
// Ported from OrdinaryDiffEqTsit5:
//   * tsit_perform_step.jl — `initialize!` (kshortsize = 7, pre-start fsal)
//     and `perform_step!` (the `Tsit5ConstantCache` variant, which computes
//     the stage states inline; this port parks them in `integ.tmp`, the
//     counterpart of the cache's `tmp` scratch field).
//   * interpolants.jl — `_ode_interpolant` with `Val{0}` (value) and `Val{1}`
//     (derivative), via the `tsit5pre0` / `tsit5pre1` weight polynomials.
//
// The tableau and interpolant coefficients live in alg_tsit5_coeffs.mbt,
// generated by tools/extract_tableaus.py from tsit_tableaus.jl (the
// `CompiledFloats` methods, i.e. what Julia's Float64 runtime dispatches to).

///|
/// The Tsit5 algorithm value. Carries no data — the tableau is compile-time
/// constants and all scratch lives in the `Integrator` — but, like `Euler`,
/// it is a field-less struct, which this MoonBit version exports to other
/// packages as read-only; callers must go through `new`.
pub struct Tsit5 {}

///|
/// The Tsit5 algorithm value.
pub fn Tsit5::new() -> Tsit5 {
  Tsit5::{ }
}

///|
pub impl Solver for Tsit5 with fn order(_self) -> Int32 {
  5
}

///|
pub impl Solver for Tsit5 with fn is_fsal(_self) -> Bool {
  true
}

///|
pub impl Solver for Tsit5 with fn stage_count(_self) -> Int32 {
  7
}

///|
pub impl Solver for Tsit5 with fn perform_step(self, integ) -> Unit {
  tsit5_perform_step(integ)
}

///|
pub impl Solver for Tsit5 with fn interpolant(_self) -> SolutionInterp {
  SolutionInterp::Poly(tsit5_interpolate, tsit5_interpolate_derivative)
}

///|
pub impl Solver for Tsit5 with fn fill_dense_stages(_self, _integ) -> Unit {
  // All 7 stages k1..k7 are already in integ.k after `perform_step`, so the
  // 4th-order interpolant has everything it needs. (Julia's Tsit5 cache has
  // no `addsteps!` method either.)
}

///|
/// Promote the trait methods onto `Tsit5` (this MoonBit version warns about
/// relying on implicit promotion).
pub impl Solver for Tsit5 with fn needs_fsal_reset_fixed_step(_self) -> Bool {
  // No diagonal mass matrix, so `update_fsal!` takes the plain
  // `copy_into(fsalfirst, fsallast)` branch in a fixed-step solve too.
  false
}

///|
pub impl Solver for Tsit5 with fn uses_bdf_controllers(_self) -> Bool {
  // Not a multistep BDF: the PI controller (control.mbt) drives the
  // step size and the generic step-reject path handles refusals.
  false
}

///|
pub extend Tsit5 with Solver::{
  order,
  is_fsal,
  stage_count,
  perform_step,
  interpolant,
  fill_dense_stages,
  needs_fsal_reset_fixed_step,
  uses_bdf_controllers,
}

///|
/// One Tsit5 step (`perform_step!`, tsit_perform_step.jl:140).
///
/// `k1` is the incoming FSAL derivative; stages 2..6 are evaluated at
/// `t + c_i*dt`; the solution uses the 7th `a` row; `fsallast` (== `k7`) is
/// `f` at the new point and becomes the next step's `fsalfirst`. Six
/// right-hand-side evaluations per step, matching Julia's `increment_nf!(6)`.
/// With `opts.adaptive` the step also produces the embedded 5(4) error
/// estimate `est` (the tolerance-scaled norm of `dt * sum b~_i k_i`).
fn tsit5_perform_step(integ : Integrator) -> Unit {
  let dt = integ.dt
  let t = integ.t
  let k1 = integ.fsalfirst
  let k2 = integ.k.unsafe_get(1)
  let k3 = integ.k.unsafe_get(2)
  let k4 = integ.k.unsafe_get(3)
  let k5 = integ.k.unsafe_get(4)
  let k6 = integ.k.unsafe_get(5)
  let k7 = integ.k.unsafe_get(6)
  let tmp = integ.tmp
  let uprev = integ.uprev
  // Stage 2 at t + c1*dt (c1 == a21 == 0.161).
  lincomb1(tmp, uprev, dt * Tsit5A21, k1)
  Integrator::eval_f(integ, t + Tsit5C1 * dt, tmp, k2)
  // Stage 3 at t + c2*dt.
  lincomb2(tmp, uprev, dt * Tsit5A31, k1, dt * Tsit5A32, k2)
  Integrator::eval_f(integ, t + Tsit5C2 * dt, tmp, k3)
  // Stage 4 at t + c3*dt.
  lincomb3(tmp, uprev, dt * Tsit5A41, k1, dt * Tsit5A42, k2, dt * Tsit5A43, k3)
  Integrator::eval_f(integ, t + Tsit5C3 * dt, tmp, k4)
  // Stage 5 at t + c4*dt.
  lincomb4(
    tmp,
    uprev,
    dt * Tsit5A51,
    k1,
    dt * Tsit5A52,
    k2,
    dt * Tsit5A53,
    k3,
    dt * Tsit5A54,
    k4,
  )
  Integrator::eval_f(integ, t + Tsit5C4 * dt, tmp, k5)
  // Stage 6 at t + dt (c5 == 1).
  lincomb5(
    tmp,
    uprev,
    dt * Tsit5A61,
    k1,
    dt * Tsit5A62,
    k2,
    dt * Tsit5A63,
    k3,
    dt * Tsit5A64,
    k4,
    dt * Tsit5A65,
    k5,
  )
  Integrator::eval_f(integ, t + dt, tmp, k6)
  // The step's solution: the 7th `a` row (c6 == 1).
  lincomb6(
    integ.u,
    uprev,
    dt * Tsit5A71,
    k1,
    dt * Tsit5A72,
    k2,
    dt * Tsit5A73,
    k3,
    dt * Tsit5A74,
    k4,
    dt * Tsit5A75,
    k5,
    dt * Tsit5A76,
    k6,
  )
  // Stage 7 == fsallast at t + dt; FSAL carries it into the next step.
  Integrator::eval_f(integ, t + dt, integ.u, integ.fsallast)
  // Store the step's stage group in the interpolant's convention:
  // k[0] = k1 (derivative at the left endpoint) ... k[6] = k7 (right).
  copy_into(integ.k.unsafe_get(0), k1)
  copy_into(k7, integ.fsallast)
  if integ.opts.adaptive {
    // Embedded error estimate (tsit_perform_step.jl:247): the difference
    // between the 5th- and 4th-order solutions, scaled by the tolerances and
    // reduced to one number by the RMS norm (`set_EEst!`).
    lincomb7(
      integ.utilde,
      dt * Tsit5Btilde1,
      k1,
      dt * Tsit5Btilde2,
      k2,
      dt * Tsit5Btilde3,
      k3,
      dt * Tsit5Btilde4,
      k4,
      dt * Tsit5Btilde5,
      k5,
      dt * Tsit5Btilde6,
      k6,
      dt * Tsit5Btilde7,
      k7,
    )
    weighted_residual(
      integ.atmp,
      integ.utilde,
      uprev,
      integ.u,
      integ.opts.abstol,
      integ.opts.reltol,
    )
    integ.est = rms_norm(integ.atmp)
  } else {
    integ.est = 0.0
  }
}

// ---------------------------------------------------------------------------
// Dense interpolant (interpolants.jl `tsit5pre0` / `tsit5pre1`)
// ---------------------------------------------------------------------------

///|
/// `c0 + c1*x + c2*x^2` (Julia's `@evalpoly(x, c0, c1, c2)`).
fn tsit5_bpoly2(x : Double, c0 : Double, c1 : Double, c2 : Double) -> Double {
  c0 + x * (c1 + x * c2)
}

///|
/// `c0 + c1*x + c2*x^2 + c3*x^3`.
fn tsit5_bpoly3(
  x : Double,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  c3 : Double,
) -> Double {
  c0 + x * (c1 + x * (c2 + x * c3))
}

///|
/// `d/dx [x * (c0 + c1*x + c2*x^2)]` = `2*c0*x + 3*c1*x^2 + 4*c2*x^3`,
/// Horner-form as `x * (2*c0 + x * (3*c1 + x * 4*c2))`.
fn tsit5_bpoly2_d(x : Double, c0 : Double, c1 : Double, c2 : Double) -> Double {
  x * (2.0 * c0 + x * (3.0 * c1 + x * 4.0 * c2))
}

///|
/// `d/dx [c0 + c1*x + c2*x^2 + c3*x^3]` = `c0 + x*(2*c1 + x*(3*c2 + x*4*c3))`.
fn tsit5_bpoly3_d(
  x : Double,
  c0 : Double,
  c1 : Double,
  c2 : Double,
  c3 : Double,
) -> Double {
  c0 + x * (2.0 * c1 + x * (3.0 * c2 + x * 4.0 * c3))
}

///|
/// Dense output at fraction `theta` of a step (`_ode_interpolant` Val{0}):
///
///     y(theta) = y0 + dt * sum_i k_i * b_i(theta)
///
/// with `b_1(theta) = theta*(r11 + r12*theta + r13*theta^2 + r14*theta^3)` and
/// `b_i(theta) = theta^2*(ri2 + ri3*theta + ri4*theta^2)` for `i = 2..7`.
/// `ks` is the stored stage group of the step (k[0] = k1 ... k[6] = k7).
fn tsit5_interpolate(
  theta : Double,
  dt : Double,
  y0 : Array[Double],
  y1 : Array[Double],
  ks : Array[Array[Double]],
  out : Array[Double],
) -> Unit {
  let th2 = theta * theta
  let b1 = theta * tsit5_bpoly3(theta, Tsit5R11, Tsit5R12, Tsit5R13, Tsit5R14)
  let b2 = th2 * tsit5_bpoly2(theta, Tsit5R22, Tsit5R23, Tsit5R24)
  let b3 = th2 * tsit5_bpoly2(theta, Tsit5R32, Tsit5R33, Tsit5R34)
  let b4 = th2 * tsit5_bpoly2(theta, Tsit5R42, Tsit5R43, Tsit5R44)
  let b5 = th2 * tsit5_bpoly2(theta, Tsit5R52, Tsit5R53, Tsit5R54)
  let b6 = th2 * tsit5_bpoly2(theta, Tsit5R62, Tsit5R63, Tsit5R64)
  let b7 = th2 * tsit5_bpoly2(theta, Tsit5R72, Tsit5R73, Tsit5R74)
  let n = out.length()
  let mut i = 0
  while i < n {
    out.unsafe_set(
      i,
      y0.unsafe_get(i) +
      dt *
      (
        ks.unsafe_get(0).unsafe_get(i) * b1 +
        ks.unsafe_get(1).unsafe_get(i) * b2 +
        ks.unsafe_get(2).unsafe_get(i) * b3 +
        ks.unsafe_get(3).unsafe_get(i) * b4 +
        ks.unsafe_get(4).unsafe_get(i) * b5 +
        ks.unsafe_get(5).unsafe_get(i) * b6 +
        ks.unsafe_get(6).unsafe_get(i) * b7
      ),
    )
    i += 1
  }
}

///|
/// Time derivative of the dense output (`_ode_interpolant` Val{1}):
///
///     dy/dt = sum_i k_i * b_i'(theta)
///
/// Note the missing `1/dt` factor relative to `b_i'` alone: the chain rule
/// contributes `dtheta/dt = 1/dt`, which cancels the `dt` in front of the
/// value formula (higher derivative orders keep an `invdt^(D-1)` factor, see
/// interpolants.jl `tsit5pre2` onward). `dt` and `y0` are accepted for
/// signature symmetry with the value closure and ignored.
fn tsit5_interpolate_derivative(
  theta : Double,
  _dt : Double,
  _y0 : Array[Double],
  _y1 : Array[Double],
  ks : Array[Array[Double]],
  out : Array[Double],
) -> Unit {
  let b1 = tsit5_bpoly3_d(theta, Tsit5R11, Tsit5R12, Tsit5R13, Tsit5R14)
  let b2 = tsit5_bpoly2_d(theta, Tsit5R22, Tsit5R23, Tsit5R24)
  let b3 = tsit5_bpoly2_d(theta, Tsit5R32, Tsit5R33, Tsit5R34)
  let b4 = tsit5_bpoly2_d(theta, Tsit5R42, Tsit5R43, Tsit5R44)
  let b5 = tsit5_bpoly2_d(theta, Tsit5R52, Tsit5R53, Tsit5R54)
  let b6 = tsit5_bpoly2_d(theta, Tsit5R62, Tsit5R63, Tsit5R64)
  let b7 = tsit5_bpoly2_d(theta, Tsit5R72, Tsit5R73, Tsit5R74)
  let n = out.length()
  let mut i = 0
  while i < n {
    out.unsafe_set(
      i,
      ks.unsafe_get(0).unsafe_get(i) * b1 +
      ks.unsafe_get(1).unsafe_get(i) * b2 +
      ks.unsafe_get(2).unsafe_get(i) * b3 +
      ks.unsafe_get(3).unsafe_get(i) * b4 +
      ks.unsafe_get(4).unsafe_get(i) * b5 +
      ks.unsafe_get(5).unsafe_get(i) * b6 +
      ks.unsafe_get(6).unsafe_get(i) * b7,
    )
    i += 1
  }
}

// ---------------------------------------------------------------------------
// Coefficient invariants (the extraction tool checks the same properties)
// ---------------------------------------------------------------------------

///|
test "tsit5 tableau rows sum to their abscissae" {
  let tol = 0.000000001
  assert_true((Tsit5A21 - Tsit5C1).abs() < tol)
  assert_true((Tsit5A31 + Tsit5A32 - Tsit5C2).abs() < tol)
  assert_true((Tsit5A41 + Tsit5A42 + Tsit5A43 - Tsit5C3).abs() < tol)
  assert_true((Tsit5A51 + Tsit5A52 + Tsit5A53 + Tsit5A54 - Tsit5C4).abs() < tol)
  assert_true(
    (Tsit5A61 + Tsit5A62 + Tsit5A63 + Tsit5A64 + Tsit5A65 - Tsit5C5).abs() < tol,
  )
  assert_true(
    (Tsit5A71 + Tsit5A72 + Tsit5A73 + Tsit5A74 + Tsit5A75 + Tsit5A76 - Tsit5C6).abs() <
    tol,
  )
  // The final row integrates constants exactly.
  assert_true(
    (Tsit5A71 + Tsit5A72 + Tsit5A73 + Tsit5A74 + Tsit5A75 + Tsit5A76 - 1.0).abs() <
    tol,
  )
}

///|
test "tsit5 interpolant weights reproduce the step endpoints" {
  // Synthetic stages: ks[i] = e_i, y0 = 0, dt = 1. Then one closure call
  // reads the b_i(theta) weights straight off `out`.
  let ks : Array[Array[Double]] = []
  let mut i = 0
  while i < 7 {
    let e = Array::make(7, 0.0)
    e.unsafe_set(i, 1.0)
    ks.push(e)
    i += 1
  }
  let y0 = Array::make(7, 0.0)
  let out = Array::make(7, 0.0)
  let tol = 0.000000001
  // theta = 0: every weight vanishes, so y(0) = y0.
  tsit5_interpolate(0.0, 1.0, y0, y0, ks, out)
  let mut j = 0
  while j < 7 {
    assert_true(out.unsafe_get(j).abs() < tol)
    j += 1
  }
  // theta = 1: the weights are the 7th `a` row (b_7(1) = 0, because k_7 is
  // not part of the step's solution formula).
  tsit5_interpolate(1.0, 1.0, y0, y0, ks, out)
  assert_true((out.unsafe_get(0) - Tsit5A71).abs() < tol)
  assert_true((out.unsafe_get(1) - Tsit5A72).abs() < tol)
  assert_true((out.unsafe_get(2) - Tsit5A73).abs() < tol)
  assert_true((out.unsafe_get(3) - Tsit5A74).abs() < tol)
  assert_true((out.unsafe_get(4) - Tsit5A75).abs() < tol)
  assert_true((out.unsafe_get(5) - Tsit5A76).abs() < tol)
  assert_true(out.unsafe_get(6).abs() < tol)
  // theta = 0: dy/dt is the first stage (b_1'(0) = r11 = 1, others 0).
  tsit5_interpolate_derivative(0.0, 1.0, y0, y0, ks, out)
  assert_true((out.unsafe_get(0) - 1.0).abs() < tol)
  j = 1
  while j < 7 {
    assert_true(out.unsafe_get(j).abs() < tol)
    j += 1
  }
  // theta = 1: dy/dt is the FSAL stage k_7 (b_7'(1) = 1, others 0).
  tsit5_interpolate_derivative(1.0, 1.0, y0, y0, ks, out)
  assert_true((out.unsafe_get(6) - 1.0).abs() < tol)
  j = 0
  while j < 6 {
    assert_true(out.unsafe_get(j).abs() < tol)
    j += 1
  }
}
