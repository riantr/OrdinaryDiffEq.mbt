// The generic tableau-driven explicit Runge-Kutta solver.
//
// Ported from OrdinaryDiffEqExplicitRK:
//   * tableaus.jl (`DiffEqBase/src/tableaus.jl:6`) — `ExplicitRKTableau`, the
//     (A, c, alpha, alphaEEst, d, stages, order, adaptiveorder, fsal,
//     stability_size, B_interp) record.
//   * explicit_rk_perform_step.jl:20 — `perform_step!` for the `ConstantCache`
//     variant: k1 comes from `fsalfirst`, the intermediate stages accumulate
//     `uprev + dt * sum_j A[i,j] k_j`, the last stage gets its own `a` row,
//     a non-FSAL method pays one extra `f(u, t+dt)` into `fsallast`, and the
//     embedded estimate is `dt * sum_i alphaEEst_i k_i`.
//   * explicit_rk_perform_step.jl:331/387 — `eval_poly_derivative` and
//     `generic_rk_interpolant`, the `B_interp` dense output.
//
// The tableaus themselves live in alg_explicit_rk_tableaus.mbt, generated by
// tools/extract_rk_tableaus.py from OrdinaryDiffEqExplicitTableaus. None of
// them ships a `B_interp`, so as upstream this port always falls back to the
// cubic Hermite form on `k[1]` and `k[stages]` (see `initialize!`:
// `kshortsize = 2` without `B_interp`, `= stages` with it).

///|
/// A Butcher tableau for an explicit Runge-Kutta method
/// (`DiffEqBase.ExplicitRKTableau`).
///
/// Field names follow upstream: `alpha` is the solution row `α`, `alpha_eest`
/// the embedded row `αEEst` (empty for a fixed-step method), `a` the
/// strictly-lower-triangular coefficient matrix.
pub(all) struct ExplicitRKTableau {
  /// `A`: row `i` (0-based) holds the coefficients of `k_1..k_i` for stage
  /// `i+1`. The diagonal is zero.
  pub a : Array[Array[Double]]
  /// `c`: stage abscissae, `sum(row i of a) == c[i]`, `c[0] == 0`.
  pub c : Array[Double]
  /// `alpha`: the solution row, `sum(alpha) == 1`.
  pub alpha : Array[Double]
  /// `alpha_eest`: the embedded method's **solution** row, empty when the
  /// method is not adaptive. Note this is *not* yet an error estimate:
  /// `ExplicitRKConstantCache` (explicit_rk_caches.jl:68) turns it into the
  /// difference row `alpha - alpha_eest`, which is what `perform_step`
  /// accumulates. `perform_step` here does that subtraction inline.
  pub alpha_eest : Array[Double]
  /// Number of stages, `a.length` rows of `stages` coefficients.
  pub stages : Int32
  /// Classical order of `alpha`.
  pub order : Int32
  /// Order of the embedded method (`adaptiveorder` upstream); 0 when the
  /// tableau carries no `alphaEEst`.
  pub adaptive_order : Int32
  /// Whether the last stage is `f` at the new point.
  pub fsal : Bool
}

///|
/// The generic explicit Runge-Kutta algorithm value. It carries the tableau
/// (unlike `Euler` / `Tsit5`, whose coefficients are compile-time constants),
/// so it is a single-field struct built by `new`.
///
/// Field-less structs are exported read-only by this MoonBit version, which
/// is fine here: the tableau is read-only data.
pub struct ExplicitRK {
  tab : ExplicitRKTableau
}

///|
/// Build an `ExplicitRK` solver from a tableau.
pub fn ExplicitRK::new(tab : ExplicitRKTableau) -> ExplicitRK {
  ExplicitRK::{ tab, }
}

///|
/// The tableau this solver runs.
pub fn ExplicitRK::tableau(self : ExplicitRK) -> ExplicitRKTableau {
  self.tab
}

///|
pub impl Solver for ExplicitRK with fn order(self) -> Int32 {
  self.tab.order
}

///|
pub impl Solver for ExplicitRK with fn is_fsal(_self) -> Bool {
  // Always true, and this is not a simplification. Upstream, `isfsal(alg)` for
  // the *algorithm* defaults to `true` (alg_utils.jl:80) and `ExplicitRK` never
  // overrides it, so `update_fsal!` always carries `fsallast` into the next
  // step's `fsalfirst`. That only works because `perform_step!` pays the extra
  // `f(u, t + dt)` whenever the *tableau* is not FSAL
  // (explicit_rk_perform_step.jl:70) — the tableau flag decides who pays for
  // `fsallast`, the algorithm flag decides who consumes it.
  true
}

///|
pub impl Solver for ExplicitRK with fn stage_count(self) -> Int32 {
  // `initialize!` (explicit_rk_perform_step.jl:6) sets kshortsize to 2 without
  // B_interp and to `stages` with it. None of the tableaus in
  // alg_explicit_rk_tableaus.mbt carries B_interp, so this port is on the
  // kshortsize = 2 path: `integrator.k` holds only the two endpoint
  // derivatives, which is exactly what the Hermite fallback reads. The stages
  // themselves live in a scratch vector inside `perform_step`.
  2
}

///|
pub impl Solver for ExplicitRK with fn perform_step(self, integ) -> Unit {
  explicit_rk_perform_step(self.tab, integ)
}

///|
pub impl Solver for ExplicitRK with fn interpolant(_self) -> SolutionInterp {
  // `OrdinaryDiffEqExplicitRK/src/interpolants.jl`: a tableau without
  // `B_interp` falls back to Hermite on the endpoint derivatives.
  SolutionInterp::Hermite
}

///|
pub impl Solver for ExplicitRK with fn fill_dense_stages(_self, _integ) -> Unit {
  // `perform_step` already fills every stage of a tableau-driven method.
}

///|
/// Promote the trait methods onto `ExplicitRK` (this MoonBit version warns
/// about relying on implicit promotion).
pub impl Solver for ExplicitRK with fn needs_fsal_reset_fixed_step(_self) -> Bool {
  // No diagonal mass matrix, so `update_fsal!` takes the plain
  // `copy_into(fsalfirst, fsallast)` branch in a fixed-step solve too.
  false
}

///|
pub impl Solver for ExplicitRK with fn uses_bdf_controllers(_self) -> Bool {
  // Not a multistep BDF: the PI controller (control.mbt) drives the
  // step size and the generic step-reject path handles refusals.
  false
}

///|
pub extend ExplicitRK with Solver::{
  order,
  is_fsal,
  stage_count,
  perform_step,
  interpolant,
  fill_dense_stages,
  needs_fsal_reset_fixed_step,
  uses_bdf_controllers,
}

///|
/// One step of the tableau method (explicit_rk_perform_step.jl:20).
///
/// Faithful to upstream's structure, which has three easily-missed details:
///
///   * `kk[1] = integrator.fsalfirst` -- k1 is *reused* from the previous step,
///     never re-evaluated, so a step costs `stages - 1` new evaluations.
///   * The last stage is evaluated at `t + c[end] * dt` built from the last row
///     of `A`, which is generally *not* `t + dt`; its result is parked in
///     `fsallast` "as temp even if not fsal" (upstream's own comment).
///   * A non-FSAL tableau then pays **one extra** `f(u, t + dt)` afterwards, so
///     its steady-state cost is `stages` evaluations per step, not `stages - 1`.
///
/// The stage derivatives live in a local array rather than in `integrator.k`:
/// upstream's `kk` is cache scratch, and `integrator.k` is left holding only the
/// two endpoint derivatives the Hermite fallback needs (`kshortsize == 2`).
fn explicit_rk_perform_step(
  tab : ExplicitRKTableau,
  integ : Integrator,
) -> Unit {
  let dt = integ.dt
  let t = integ.t
  let uprev = integ.uprev
  let a = tab.a
  let c = tab.c
  let stages = tab.stages
  let dim = integ.u.length()
  // Scratch stage derivatives, indexed like the tableau: `kk[j]` is k_{j+1}.
  let kk : Array[Array[Double]] = []
  let mut s = 0
  while s < stages {
    kk.push(Array::make(dim, 0.0))
    s += 1
  }
  copy_into(kk.unsafe_get(0), integ.fsalfirst)
  // Middle stages 2..stages-1.
  let mut i = 1
  while i < stages - 1 {
    generic_stage_state(kk, a.unsafe_get(i), i, dt, uprev, integ.tmp)
    Integrator::eval_f(
      integ,
      t + c.unsafe_get(i) * dt,
      integ.tmp,
      kk.unsafe_get(i),
    )
    i += 1
  }
  // Last stage: the state comes from the last row of A, and the abscissa is
  // c[end] -- not necessarily dt.
  let last = stages - 1
  generic_stage_state(kk, a.unsafe_get(last), last, dt, uprev, integ.u)
  Integrator::eval_f(
    integ,
    t + c.unsafe_get(last) * dt,
    integ.u,
    kk.unsafe_get(last),
  )
  copy_into(integ.fsallast, kk.unsafe_get(last))
  // Accumulate the result from the solution row alpha.
  let alpha = tab.alpha
  let mut r = 0
  while r < dim {
    let mut acc = uprev.unsafe_get(r)
    let mut j = 0
    while j < stages {
      acc += dt * alpha.unsafe_get(j) * kk.unsafe_get(j).unsafe_get(r)
      j += 1
    }
    integ.u.unsafe_set(r, acc)
    r += 1
  }
  if !tab.fsal {
    // Upstream: `elseif !isfsal(alg.tableau); integrator.fsallast = f(u, t+dt)`.
    // Only now is `fsallast` the derivative at the *new* point, which is what
    // the Hermite interpolant needs at its right endpoint.
    Integrator::eval_f(integ, t + dt, integ.u, integ.fsallast)
  }
  if integ.opts.adaptive && tab.adaptive_order > 0 {
    // Embedded error estimate (explicit_rk_perform_step.jl:76):
    // `utilde = dt * sum_i alphaEEst_i k_i` -- where the `alphaEEst` this loop
    // reads is *not* the tableau field but the difference row built in
    // `ExplicitRKConstantCache` (explicit_rk_caches.jl:68):
    //
    //     alphaEEst = isempty(alphaEEst) ? alphaEEst : alpha .- alphaEEst
    //
    // The tableau stores the embedded method's own *solution* row, so the
    // subtraction here is what turns it into an error estimate. Getting this
    // wrong yields a "difference" that sums to 1 rather than 0, i.e. an error
    // estimate proportional to the solution itself.
    let alpha_eest = tab.alpha_eest
    let alpha = tab.alpha
    let zero = Array::make(dim, 0.0)
    let dt_row = Array::make(stages, 0.0)
    let mut j = 0
    while j < stages {
      dt_row.unsafe_set(
        j,
        dt * (alpha.unsafe_get(j) - alpha_eest.unsafe_get(j)),
      )
      j += 1
    }
    lincomb_range(integ.utilde, zero, dt_row, kk)
    weighted_residual(
      integ.atmp,
      integ.utilde,
      uprev,
      integ.u,
      integ.opts.abstol,
      integ.opts.reltol,
    )
    integ.est = rms_norm(integ.atmp)
  } else {
    integ.est = 0.0
  }
  // The two endpoint derivatives are what `integrator.k` is for on the
  // kshortsize == 2 path (explicit_rk_perform_step.jl:107).
  let k = integ.k
  copy_into(k.unsafe_get(0), integ.fsalfirst)
  copy_into(k.unsafe_get(1), integ.fsallast)
}

///|
/// `out = uprev + dt * sum_{j=0}^{n-1} row[j] * kk[j]` for `j < n`
/// (explicit_rk_perform_step.jl:41, `sum(...)` over the tableau column).
///
/// This is upstream's `sum(A[j,i] * kk[j] for j in 1:(i-1))` walk; it has to
/// be a loop here because the row length is only known at run time, which is
/// exactly the case the unrolled `lincomb1..lincomb7` kernels cannot serve.
fn generic_stage_state(
  kk : Array[Array[Double]],
  row : Array[Double],
  n : Int32,
  dt : Double,
  uprev : Array[Double],
  out : Array[Double],
) -> Unit {
  let dim = out.length()
  let mut i = 0
  while i < dim {
    let mut acc = uprev.unsafe_get(i)
    let mut j = 0
    while j < n {
      acc += dt * row.unsafe_get(j) * kk.unsafe_get(j).unsafe_get(i)
      j += 1
    }
    out.unsafe_set(i, acc)
    i += 1
  }
}

///|
/// `eval_poly_derivative` (explicit_rk_perform_step.jl:331): the `k`-th
/// derivative of the polynomial with coefficients `coef`, i.e.

///|
/// `falling_factorial(n, k) = n * (n-1) * .. * (n-k+1)`
/// (explicit_rk_perform_step.jl:317).
fn falling_factorial(n : Int32, k : Int32) -> Double {
  let mut result = 1.0
  let mut j = 0
  while j < k {
    result *= (n - j).to_double()
    j += 1
  }
  result
}

///|
/// `eval_poly_derivative(theta, coef, order)` (explicit_rk_perform_step.jl:331):
/// the `order`-th derivative at `theta` of the polynomial
/// `sum_j coef[j] * theta^j`, evaluated by Horner's method.
///
/// Two details are easy to get wrong and both matter:
///
///   * A polynomial of degree `n - 1` has an `order`-th derivative that is
///     identically zero once `order >= n`, so upstream returns early
///     (`if n <= order`).
///   * The multipliers are a **falling** factorial `j!/(j-order)!`, not a
///     rising one. `coef[j]` therefore drops out entirely for
///     `j < order`, which is why the Horner sweep starts at `order`.
///
/// `order == 0` is plain Horner and needs no multipliers at all.
pub fn eval_poly_derivative(
  theta : Double,
  coef : Array[Double],
  order : Int32,
) -> Double {
  let n = coef.length()
  if n <= order {
    return 0.0
  }
  if order == 0 {
    let mut result = coef.unsafe_get(n - 1)
    let mut i = n - 2
    while i >= 0 {
      result = theta * result + coef.unsafe_get(i)
      i -= 1
    }
    return result
  }
  // Horner over `coef[j] * falling_factorial(j, order)`, starting from the
  // leading term and stopping at `j == order` (the lower coefficients have a
  // zero multiplier).
  let mut result = coef.unsafe_get(n - 1) * falling_factorial(n - 1, order)
  let mut j = n - 2
  while j >= order {
    result = theta * result + coef.unsafe_get(j) * falling_factorial(j, order)
    j -= 1
  }
  result
}

///|
/// `generic_rk_interpolant` (explicit_rk_perform_step.jl:387):
///
///     order == 0:  y0 + dt * sum_i k_i * P_i(theta)
///     order >= 1:  sum_i k_i * P_i'(theta) / dt^(order - 1)
///
/// where `P_i` is the polynomial of row `i` of `b_interp`. The second form is
/// the chain rule: `d/dtheta [ dt * P_i(theta) ] * dtheta/dt`, with
/// `dtheta/dt = 1/dt`. Note `order == 1` has `inv_dt_factor == 1` upstream, so
/// there is no `1/dt` left to cancel -- the same shape as Tsit5's and Vern7's
/// derivative closures.
///
/// `b_interp` is row-major: `nstages` rows of polynomial coefficients.
///
/// `dt` and `y0` are ignored when `order != 0`, as upstream.
pub fn generic_rk_interpolate(
  theta : Double,
  dt : Double,
  y0 : Array[Double],
  ks : Array[Array[Double]],
  b_interp : Array[Array[Double]],
  order : Int32,
  out : Array[Double],
) -> Unit {
  let nstages = b_interp.length()
  let inv_dt_factor = if order <= 1 {
    1.0
  } else {
    fastpower(1.0 / dt, (order - 1).to_double())
  }
  let n = out.length()
  let mut i = 0
  while i < n {
    let mut interp_sum = 0.0
    let mut s = 0
    while s < nstages {
      interp_sum += ks.unsafe_get(s).unsafe_get(i) *
        eval_poly_derivative(theta, b_interp.unsafe_get(s), order)
      s += 1
    }
    if order == 0 {
      out.unsafe_set(i, y0.unsafe_get(i) + dt * interp_sum)
    } else {
      out.unsafe_set(i, interp_sum * inv_dt_factor)
    }
    i += 1
  }
}
